rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Customer profile photos: Owner can write; any authenticated user can read
    match /customer_profile_photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Driver profile photos: Owner can write; any authenticated user can read
    match /driver_profile_photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Driver documents & verification files: Owner can write; authenticated users can read
    match /driver_documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Support chat attachments & tickets
    match /supportChats/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /support_tickets/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Fleet logos, documents & rental vehicle photos
    match /fleet_logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /fleet_documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /rental_vehicles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Announcements, Banners & Popups
    match /announcements/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /banners/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /popups/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
