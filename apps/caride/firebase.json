{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "caride-app",
          "appId": "1:907513616513:android:25c02f1d4d0b96aff45580",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "caride-app",
          "appId": "1:907513616513:ios:ed77f1a0eb8fb68cf45580",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "caride-app",
          "configurations": {
            "android": "1:907513616513:android:25c02f1d4d0b96aff45580",
            "ios": "1:907513616513:ios:ed77f1a0eb8fb68cf45580"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}