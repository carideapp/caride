# Port on which the Node.js proxy server listens (behind Caddy or Nginx)
PORT=3000
NODE_ENV=production

# Shared Secret Bearer Token between Firebase Cloud Functions and this Proxy
# Generate a strong 64+ char random token using: openssl rand -hex 32
PROXY_AUTH_TOKEN=your_secure_random_proxy_token_here_change_in_production

# Upstream TransactPay Gateway
TRANSACTPAY_UPSTREAM_HOST=payment-api-service.transactpay.ai
TRANSACTPAY_UPSTREAM_PROTOCOL=https:

# Upstream request timeout in milliseconds (default 30 seconds)
UPSTREAM_TIMEOUT_MS=30000

# Rate limiting: max requests per minute per IP (default 120)
RATE_LIMIT_MAX_PER_MINUTE=120

# Optional fallback credentials (if not passed in request headers from Firebase)
# If provided, the proxy can inject these if incoming request doesn't specify api-key
TRANSACTPAY_PUBLIC_KEY=PGW-PUBLICKEY-YOUR-KEY-HERE
TRANSACTPAY_SECRET_KEY=PGW-SECRETKEY-YOUR-KEY-HERE

# VPS Static IPv4 Address (for documentation and verification endpoint)
VPS_STATIC_IPV4=127.0.0.1
